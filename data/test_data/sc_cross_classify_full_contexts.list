../data/kernel-code/linux-6.18-rc5/mm/vmscan.c ;; 6495 ;; if (atomic_read(&pgdat->kswapd_failures) >= MAX_RECLAIM_RETRIES) ;; throttle_direct_reclaim ;; wait_event_interruptible_timeout(pgdat->pfmemalloc_wait, allow_direct_reclaim(pgdat), HZ); ;; ['static bool throttle_direct_reclaim(gfp_t gfp_mask, struct zonelist *zonelist,//##6532', 'nodemask_t *nodemask)//##6533', '{//##6534', 'struct zoneref *z;//##6535', 'struct zone *zone;//##6536', 'pg_data_t *pgdat = NULL;//##6537', '//##6538', '/*//##6539', '* Kernel threads should not be throttled as they may be indirectly//##6540', '* responsible for cleaning pages necessary for reclaim to make forward//##6541', '* progress. kjournald for example may enter direct reclaim while//##6542', '* committing a transaction where throttling it could forcing other//##6543', '* processes to block on log_wait_commit().//##6544', '*///##6545', 'if (current->flags & PF_KTHREAD)//##6546', 'goto out;//##6547', '//##6548', '/*//##6549', '* If a fatal signal is pending, this process should not throttle.//##6550', '* It should return quickly so it can exit and free its memory//##6551', '*///##6552', 'if (fatal_signal_pending(current))//##6553', 'goto out;//##6554', '//##6555', '/*//##6556', '* Check if the pfmemalloc reserves are ok by finding the first node//##6557', '* with a usable ZONE_NORMAL or lower zone. The expectation is that//##6558', '* GFP_KERNEL will be required for allocating network buffers when//##6559', '* swapping over the network so ZONE_HIGHMEM is unusable.//##6560', '*//##6561', '* Throttling is based on the first usable node and throttled processes//##6562', '* wait on a queue until kswapd makes progress and wakes them. There//##6563', '* is an affinity then between processes waking up and where reclaim//##6564', '* progress has been made assuming the process wakes on the same node.//##6565', '* More importantly, processes running on remote nodes will not compete//##6566', '* for remote pfmemalloc reserves and processes on different nodes//##6567', '* should make reasonable progress.//##6568', '*///##6569', 'for_each_zone_zonelist_nodemask(zone, z, zonelist,//##6570', 'gfp_zone(gfp_mask), nodemask) {//##6571', 'if (zone_idx(zone) > ZONE_NORMAL)//##6572', 'continue;//##6573', '//##6574', '/* Throttle based on the first usable node *///##6575', 'pgdat = zone->zone_pgdat;//##6576', 'if (allow_direct_reclaim(pgdat))//##6577', 'goto out;//##6578', 'break;//##6579', '}//##6580', '//##6581', '/* If no zone was usable by the allocation flags then do not throttle *///##6582', 'if (!pgdat)//##6583', 'goto out;//##6584', '//##6585', '/* Account for the throttling *///##6586', 'count_vm_event(PGSCAN_DIRECT_THROTTLE);//##6587', '//##6588', '/*//##6589', "* If the caller cannot enter the filesystem, it's possible that it//##6590", '* is due to the caller holding an FS lock or performing a journal//##6591', '* transaction in the case of a filesystem like ext[3|4]. In this case,//##6592', '* it is not safe to block on pfmemalloc_wait as kswapd could be//##6593', '* blocked waiting on the same lock. Instead, throttle for up to a//##6594', '* second before continuing.//##6595', '*///##6596', 'if (!(gfp_mask & __GFP_FS))//##6597', 'wait_event_interruptible_timeout(pgdat->pfmemalloc_wait,//##6598', 'static bool allow_direct_reclaim(pg_data_t *pgdat)//##6487', '{//##6488', 'struct zone *zone;//##6489', 'unsigned long pfmemalloc_reserve = 0;//##6490', 'unsigned long free_pages = 0;//##6491', 'int i;//##6492', 'bool wmark_ok;//##6493', '//##6494', 'if (atomic_read(&pgdat->kswapd_failures) >= MAX_RECLAIM_RETRIES)//##6495'] ;; Assignment Statement ;; Yes
